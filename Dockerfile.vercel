FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

WORKDIR /app

# XGBoost/scikit-learn runtime support.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-vercel.txt ./requirements-vercel.txt
RUN pip install --upgrade pip \
    && pip install -r requirements-vercel.txt

COPY . .

# Vercel provides PORT to container deployments. Streamlit must listen on
# all interfaces so Vercel can route traffic into the container.
CMD ["sh", "-c", "streamlit run webapp/streamlit_app.py --server.address=0.0.0.0 --server.port=${PORT:-80} --server.headless=true"]
